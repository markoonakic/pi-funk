{
  "theme": "gruvbox",
  "defaultThinkingLevel": "max",
  "quietStartup": true,
  "packages": [
    {
      "source": "git:git@github.com:lmilojevicc/pi-zza",
      "extensions": [
        "packages/account-router/src/index.ts",
        "packages/root-resume/extensions/root-resume.ts",
        "packages/codex-usage/extensions/codex-usage.ts",
        "packages/funky-ui/extensions/index.ts",
        "packages/funky-ui/extensions/funky-ui.ts",
        "packages/working-line/src/index.ts",
        "packages/codex-fast-mode/index.ts",
        "packages/peon-ping/src/index.ts"
      ]
    },
    "npm:@howaboua/pi-auto-trees",
    "git:github.com/nicobailon/pi-subagents",
    "git:github.com/markoonakic/pi-web-access@feat/openai-native-web-search",
    "npm:@ff-labs/pi-fff",
    "npm:pi-rewind-hook",
    "npm:@aliou/pi-processes",
    "npm:pi-intercom",
    "npm:pi-thinking-steps",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-btw",
    {
      "source": "git:github.com/mattpocock/skills",
      "extensions": [],
      "skills": [
        "skills/productivity/grill-me",
        "skills/productivity/grilling",
        "skills/productivity/handoff",
        "skills/productivity/teach",
        "skills/productivity/writing-great-skills"
      ],
      "prompts": [],
      "themes": []
    },
    {
      "source": "git:github.com/rjs/shaping-skills",
      "extensions": [],
      "skills": [
        "+shaping"
      ],
      "prompts": [],
      "themes": []
    },
    "npm:pi-mcp-adapter",
    {
      "source": "git:github.com/browser-use/browser-use",
      "extensions": [],
      "skills": [
        "skills/browser-use"
      ],
      "prompts": [],
      "themes": []
    },
    {
      "source": "git:github.com/ogulcancelik/herdr",
      "extensions": [],
      "skills": [
        "SKILL.md"
      ],
      "prompts": [],
      "themes": []
    },
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "pi-working-line": {
    "enabled": true,
    "phrases": {
      "mode": "append",
      "verbs": []
    },
    "segments": {
      "phrase": true,
      "suffix": true,
      "elapsed": true,
      "thinking": true,
      "tokens": false
    },
    "turnDuration": {
      "enabled": true,
      "thresholdMs": 30000
    }
  },
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.80.2",
  "transport": "auto",
  "pi-account-router": {
    "showFooter": true
  },
  "diffPalette": "auto",
  "diffShikiTheme": "gruvbox-dark-medium"
}
