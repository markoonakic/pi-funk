{
  "defaultProjectTrust": "never",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    {
      "source": "npm:@aliou/pi-processes",
      "extensions": [
        "extensions/processes/index.ts"
      ],
      "skills": []
    },
    {
      "source": "git:github.com/lmilojevicc/pi-zza",
      "extensions": [
        "packages/codex-native-compaction/extensions/codex-native-compaction.ts"
      ],
      "skills": []
    },
    {
      "source": "npm:pi-lens",
      "skills": []
    },
    "~/.config/pi/extensions/cliproxy-models"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 100000
  }
}
