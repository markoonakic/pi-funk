{
  "theme": "gruvbox",
  "defaultThinkingLevel": "xhigh",
  "quietStartup": true,
  "packages": [
    "npm:@burneikis/pi-vim",
    "npm:pi-tool-display",
    "npm:pi-caffeinate",
    "npm:pi-subagents",
    "/Users/marko/code/pi-web-access",
    "npm:pi-rewind",
    "/Users/marko/Projects/pi-account-router",
    "npm:@markoonakic/pi-working-line",
    "git:github.com/SamuelLHuber/pi-fff@dda3f8c",
    "npm:@aliou/pi-processes",
    "npm:pi-intercom",
    "npm:pi-design-deck",
    "npm:pi-thinking-steps"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4",
  "pi-working-line": {
    "enabled": true,
    "phrases": {
      "mode": "append",
      "verbs": []
    },
    "segments": {
      "phrase": true,
      "suffix": true,
      "elapsed": true,
      "thinking": true,
      "tokens": false
    },
    "turnDuration": {
      "enabled": true,
      "thresholdMs": 30000
    }
  },
  "hideThinkingBlock": false,
  "pi-account-router": {
    "showFooter": true,
    "labels": {}
  },
  "lastChangelogVersion": "0.68.0"
}