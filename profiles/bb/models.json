{
  "providers": {
    "openai-codex": {
      "name": "Codex",
      "baseUrl": "http://127.0.0.1:8317/v1",
      "api": "openai-responses",
      "apiKey": "!cat \"$HOME/.pi/bb-agent/cliproxy-api-key\"",
      "compat": {
        "sessionAffinityFormat": "openai"
      },
      "modelOverrides": {
        "gpt-6.1-terra": {
          "name": "GPT-6.1 Terra",
          "reasoning": true,
          "input": ["text", "image"],
          "thinkingLevelMap": {
            "off": "none",
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "contextWindow": 1000000,
          "maxTokens": 128000
        },
        "gpt-6.1-sol": {
          "contextWindow": 1000000,
          "maxTokens": 128000
        },
        "gpt-6-sol": {
          "contextWindow": 1000000,
          "maxTokens": 128000
        },
        "gpt-6-luna": {
          "contextWindow": 1000000,
          "maxTokens": 128000
        },
        "gpt-6-astra": {
          "contextWindow": 1000000,
          "maxTokens": 128000
        },
        "gpt-5.6-sol": {
          "contextWindow": 1000000,
          "maxTokens": 128000
        },
        "gpt-5.6-luna": {
          "contextWindow": 1000000,
          "maxTokens": 128000
        }
      }
    },
    "antigravity": {
      "name": "Antigravity",
      "baseUrl": "http://127.0.0.1:8317/v1",
      "api": "openai-responses",
      "apiKey": "!cat \"$HOME/.pi/bb-agent/cliproxy-api-key\"",
      "compat": {
        "sessionAffinityFormat": "openai"
      }
    },
    "cliproxy-go": {
      "name": "OpenCode Go",
      "baseUrl": "http://127.0.0.1:8317/v1",
      "api": "openai-responses",
      "apiKey": "!cat \"$HOME/.pi/bb-agent/cliproxy-api-key\"",
      "compat": {
        "sessionAffinityFormat": "openai"
      }
    },
    "cliproxy": {
      "name": "Command Code",
      "baseUrl": "http://127.0.0.1:8317/v1",
      "api": "openai-responses",
      "apiKey": "!cat \"$HOME/.pi/bb-agent/cliproxy-api-key\"",
      "compat": {
        "sessionAffinityFormat": "openai"
      }
    }
  }
}
